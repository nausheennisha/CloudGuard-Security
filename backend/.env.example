# AWS credentials (only needed when running a live scan; otherwise CloudGuard
# runs entirely on bundled mock data). Standard boto3 resolution order also
# works: shared credentials file, environment variables, or an instance/task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# CORS: comma-separated list of allowed frontend origins in production
CORS_ORIGINS=http://localhost:3000
